OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=30
MAX_AGENT_RETRIES=2
MIN_RECOMMENDATION_CONFIDENCE=0.75
LOG_LEVEL=INFO
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
